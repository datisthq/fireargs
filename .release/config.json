{
  "separate-pull-requests": false,
  "packages": {
    "typescript": {
      "release-type": "node",
      "component": "typescript",
      "include-component-in-tag": true
    },
    "python": {
      "release-type": "python",
      "package-name": "fireargs",
      "component": "python",
      "include-component-in-tag": true,
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        },
        {
          "type": "deps",
          "section": "Dependencies"
        },
        {
          "type": "revert",
          "section": "Reverts"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": true
        }
      ]
    },
    "rust": {
      "release-type": "rust",
      "package-name": "fireargs",
      "component": "rust",
      "include-component-in-tag": true
    }
  }
}
