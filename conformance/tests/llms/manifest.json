[
  {
    "description": "--llms prints an MCP-shaped manifest",
    "tests": [
      {
        "description": "the program lists the help tool, then every leaf by its path",
        "argv": ["--llms"],
        "exitCode": 0,
        "tools": [
          {
            "name": "help",
            "description": "Documentation tool, not callable. Each `tools[].name` is the space-separated path beneath this binary. Invoke a tool with `<binary> <name> --json '<value>'` matching that tool's `inputSchema`; output is JSON on stdout matching `outputSchema`."
          },
          { "name": "echo", "description": "Echo the input back" },
          { "name": "strict", "description": "Require a count of at least 10" },
          { "name": "tags", "description": "Collect tags and rows" },
          { "name": "pick", "description": "Pick typed values" },
          { "name": "ratio", "description": "Divide zero by zero" },
          { "name": "admin reset", "description": "Reset everything" }
        ],
        "instances": [
          { "tool": "echo", "io": "input", "data": { "path": "a.csv" }, "valid": true },
          { "tool": "echo", "io": "input", "data": {}, "valid": false },
          {
            "tool": "echo",
            "io": "input",
            "data": { "path": "a.csv", "limit": 0 },
            "valid": false
          },
          {
            "tool": "echo",
            "io": "input",
            "data": { "path": "a.csv", "role": "user" },
            "valid": true
          },
          {
            "tool": "echo",
            "io": "input",
            "data": { "path": "a.csv", "role": "root" },
            "valid": false
          },
          {
            "tool": "echo",
            "io": "input",
            "data": { "path": "a.csv", "headerRows": 2 },
            "valid": true
          },
          {
            "tool": "echo",
            "io": "input",
            "data": { "path": "a.csv", "headerRows": "2" },
            "valid": false
          },
          {
            "tool": "echo",
            "io": "output",
            "data": { "path": "a.csv", "limit": 20, "verbose": false },
            "valid": true
          },
          { "tool": "echo", "io": "output", "data": { "path": "a.csv" }, "valid": false },
          { "tool": "strict", "io": "input", "data": { "count": 10 }, "valid": true },
          { "tool": "strict", "io": "input", "data": { "count": 9 }, "valid": false },
          {
            "tool": "tags",
            "io": "input",
            "data": { "tags": ["a", "b"], "rows": [1] },
            "valid": true
          },
          { "tool": "tags", "io": "input", "data": { "tags": "a,b" }, "valid": false },
          { "tool": "tags", "io": "input", "data": { "rows": [1.5] }, "valid": false },
          {
            "tool": "pick",
            "io": "input",
            "data": { "level": 2, "pair": [1, "a"], "tone": "low" },
            "valid": true
          },
          { "tool": "pick", "io": "input", "data": { "level": 3 }, "valid": false },
          { "tool": "pick", "io": "input", "data": { "level": "2" }, "valid": false },
          {
            "tool": "pick",
            "io": "input",
            "data": { "pair": ["1", "a"] },
            "valid": false
          },
          { "tool": "pick", "io": "input", "data": { "tone": "mid" }, "valid": false },
          { "tool": "ratio", "io": "output", "data": { "value": 0.5 }, "valid": true },
          { "tool": "ratio", "io": "output", "data": {}, "valid": false },
          { "tool": "admin reset", "io": "input", "data": {}, "valid": true }
        ]
      },
      {
        "description": "a leaf lists the help tool and itself",
        "argv": ["strict", "--llms"],
        "exitCode": 0,
        "tools": [
          {
            "name": "help",
            "description": "Documentation tool, not callable. Each `tools[].name` is the space-separated path beneath this binary. Invoke a tool with `<binary> <name> --json '<value>'` matching that tool's `inputSchema`; output is JSON on stdout matching `outputSchema`."
          },
          { "name": "strict", "description": "Require a count of at least 10" }
        ]
      },
      {
        "description": "a nested program names its tools by their full path",
        "argv": ["admin", "--llms"],
        "exitCode": 0,
        "tools": [
          {
            "name": "help",
            "description": "Documentation tool, not callable. Each `tools[].name` is the space-separated path beneath this binary. Invoke a tool with `<binary> <name> --json '<value>'` matching that tool's `inputSchema`; output is JSON on stdout matching `outputSchema`."
          },
          { "name": "admin reset", "description": "Reset everything" }
        ],
        "instances": [{ "tool": "admin reset", "io": "input", "data": {}, "valid": true }]
      },
      {
        "description": "a nested leaf names itself by its full path",
        "argv": ["admin", "reset", "--llms"],
        "exitCode": 0,
        "tools": [
          {
            "name": "help",
            "description": "Documentation tool, not callable. Each `tools[].name` is the space-separated path beneath this binary. Invoke a tool with `<binary> <name> --json '<value>'` matching that tool's `inputSchema`; output is JSON on stdout matching `outputSchema`."
          },
          { "name": "admin reset", "description": "Reset everything" }
        ]
      },
      {
        "description": "a standalone command lists the help tool and itself, called as the binary",
        "argv": ["--llms"],
        "fixture": "command",
        "exitCode": 0,
        "tools": [
          {
            "name": "help",
            "description": "Documentation tool, not callable. The other tool is this binary itself. Invoke it with `<binary> --json '<value>'` matching that tool's `inputSchema`; output is JSON on stdout matching `outputSchema`."
          },
          { "name": "solo", "description": "Greet someone" }
        ],
        "instances": [
          { "tool": "solo", "io": "input", "data": {}, "valid": true },
          { "tool": "solo", "io": "input", "data": { "times": 0 }, "valid": false },
          {
            "tool": "solo",
            "io": "output",
            "data": { "name": "world", "times": 1, "loud": false },
            "valid": true
          }
        ]
      }
    ]
  }
]
