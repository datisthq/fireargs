[
  {
    "description": "input errors read like commander's",
    "tests": [
      {
        "description": "a missing positional",
        "argv": ["echo"],
        "exitCode": 1,
        "stderr": "error: missing required argument 'path'"
      },
      {
        "description": "a missing required option",
        "argv": ["strict"],
        "exitCode": 1,
        "stderr": "error: required option '--count <value>' not specified"
      },
      {
        "description": "a number flag given a word",
        "argv": ["echo", "a.csv", "-l", "abc"],
        "exitCode": 1,
        "stderr": "error: option '-l, --limit <value>' argument 'abc' is invalid. Not a number."
      },
      {
        "description": "a value the schema rejects",
        "argv": ["strict", "--count", "3"],
        "exitCode": 1,
        "stderr": "error: option '--count <value>' argument '3' is invalid. "
      },
      {
        "description": "an invalid value is quoted as typed, not as converted",
        "argv": ["strict", "--count", "03"],
        "exitCode": 1,
        "stderr": "error: option '--count <value>' argument '03' is invalid. "
      },
      {
        "description": "--json given text that is not JSON",
        "argv": ["echo", "--json", "{bad"],
        "exitCode": 1,
        "stderr": "error: --json value is not valid JSON: "
      },
      {
        "description": "--json input the schema rejects",
        "argv": ["echo", "--json", "{\"path\":1}"],
        "exitCode": 1,
        "stderr": "error: invalid --json input at 'path': "
      }
    ]
  }
]
