[
  {
    "description": "--json <value> drives input",
    "tests": [
      {
        "description": "a JSON value supplies the required positional",
        "argv": ["echo", "--json", "{\"path\":\"b.csv\",\"limit\":3}"],
        "exitCode": 0,
        "stdout": { "path": "b.csv", "limit": 3, "verbose": false }
      },
      {
        "description": "JSON keys are the input keys, not the flag names",
        "argv": ["echo", "--json", "{\"path\":\"b.csv\",\"headerRows\":1}"],
        "exitCode": 0,
        "stdout": { "path": "b.csv", "limit": 20, "verbose": false, "headerRows": 1 }
      },
      {
        "description": "bare --json still reads argv",
        "argv": ["strict", "--count", "12", "--json"],
        "exitCode": 0,
        "stdout": { "count": 12 }
      }
    ]
  },
  {
    "description": "--json input is strict JSON with finite numbers",
    "tests": [
      {
        "description": "NaN is not JSON",
        "argv": ["echo", "--json", "{\"path\":\"a.csv\",\"limit\":NaN}"],
        "exitCode": 1,
        "stderr": "error: --json value is not valid JSON: "
      },
      {
        "description": "Infinity is not JSON",
        "argv": ["echo", "--json", "{\"path\":\"a.csv\",\"limit\":Infinity}"],
        "exitCode": 1,
        "stderr": "error: --json value is not valid JSON: "
      },
      {
        "description": "a number out of range is not JSON",
        "argv": ["echo", "--json", "{\"path\":\"a.csv\",\"limit\":1e400}"],
        "exitCode": 1,
        "stderr": "error: --json value is not valid JSON: "
      },
      {
        "description": "an integral float fills an integer field",
        "argv": ["echo", "--json", "{\"path\":\"a.csv\",\"limit\":3.0}"],
        "exitCode": 0,
        "stdout": { "path": "a.csv", "limit": 3, "verbose": false }
      }
    ]
  }
]
