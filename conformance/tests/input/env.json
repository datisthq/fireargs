[
  {
    "description": "an option falls back to its env var",
    "tests": [
      {
        "description": "the env var fills an absent option",
        "fixture": "command",
        "argv": ["--json"],
        "env": {
          "SOLO_TIMES": "3"
        },
        "exitCode": 0,
        "stdout": {
          "name": "world",
          "times": 3,
          "loud": false
        }
      },
      {
        "description": "the flag beats the env var",
        "fixture": "command",
        "argv": ["-t", "2", "--json"],
        "env": {
          "SOLO_TIMES": "3"
        },
        "exitCode": 0,
        "stdout": {
          "name": "world",
          "times": 2,
          "loud": false
        }
      },
      {
        "description": "a bad env value names its env var",
        "fixture": "command",
        "argv": ["--json"],
        "env": {
          "SOLO_TIMES": "abc"
        },
        "exitCode": 1,
        "stderr": "error: option '-t, --times <value>' value 'abc' from env 'SOLO_TIMES' is invalid. Not a number."
      }
    ]
  },
  {
    "description": "a boolean env var reads as a boolean",
    "tests": [
      {
        "description": "a true word sets it",
        "argv": ["admin", "reset", "--json"],
        "env": {
          "FIXTURE_FORCE": "1"
        },
        "exitCode": 0,
        "stdout": {
          "force": true,
          "backup": true
        }
      },
      {
        "description": "the words are trimmed and case-insensitive",
        "argv": ["admin", "reset", "--json"],
        "env": {
          "FIXTURE_FORCE": " Yes "
        },
        "exitCode": 0,
        "stdout": {
          "force": true,
          "backup": true
        }
      },
      {
        "description": "a false word overrides a true default",
        "argv": ["admin", "reset", "--json"],
        "env": {
          "FIXTURE_BACKUP": "false"
        },
        "exitCode": 0,
        "stdout": {
          "force": false,
          "backup": false
        }
      },
      {
        "description": "an empty value leaves the default",
        "argv": ["admin", "reset", "--json"],
        "env": {
          "FIXTURE_FORCE": "",
          "FIXTURE_BACKUP": ""
        },
        "exitCode": 0,
        "stdout": {
          "force": false,
          "backup": true
        }
      },
      {
        "description": "the flag beats the env var",
        "argv": ["admin", "reset", "--backup", "--json"],
        "env": {
          "FIXTURE_BACKUP": "off"
        },
        "exitCode": 0,
        "stdout": {
          "force": false,
          "backup": true
        }
      },
      {
        "description": "any other value fails",
        "argv": ["admin", "reset", "--json"],
        "env": {
          "FIXTURE_FORCE": "maybe"
        },
        "exitCode": 1,
        "stderr": "error: option '--force' value 'maybe' from env 'FIXTURE_FORCE' is invalid. Not a boolean."
      }
    ]
  }
]
