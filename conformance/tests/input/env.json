[
  {
    "description": "an option falls back to its env var",
    "tests": [
      {
        "description": "the env var fills an absent option",
        "fixture": "command",
        "argv": ["--json"],
        "env": { "SOLO_TIMES": "3" },
        "exitCode": 0,
        "stdout": { "name": "world", "times": 3, "loud": false }
      },
      {
        "description": "the flag beats the env var",
        "fixture": "command",
        "argv": ["-t", "2", "--json"],
        "env": { "SOLO_TIMES": "3" },
        "exitCode": 0,
        "stdout": { "name": "world", "times": 2, "loud": false }
      }
    ]
  }
]
