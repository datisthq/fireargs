[
  {
    "description": "option config shapes argv",
    "tests": [
      {
        "description": "parse turns one CLI string into the field's value",
        "argv": ["tags", "--tags", "a,b", "--json"],
        "exitCode": 0,
        "stdout": {
          "tags": ["a", "b"],
          "rows": []
        }
      },
      {
        "description": "a repeated array option collects numbers",
        "argv": ["tags", "--rows", "1", "--rows", "2", "--json"],
        "exitCode": 0,
        "stdout": {
          "tags": [],
          "rows": [1, 2]
        }
      },
      {
        "description": "an array option rejects the element that is not a number",
        "argv": ["tags", "--rows", "1", "--rows", "x"],
        "exitCode": 1,
        "stderr": "error: option '--rows <value...>' argument 'x' is invalid. Not a number."
      },
      {
        "description": "--json input skips parse",
        "argv": ["tags", "--json", "{\"tags\":\"a,b\"}"],
        "exitCode": 1,
        "stderr": "error: invalid --json input at 'tags': "
      },
      {
        "description": "conflicts name input keys",
        "argv": ["tags", "--loud", "--quiet"],
        "exitCode": 1,
        "stderr": "error: option '--loud' cannot be used with option '--quiet'"
      },
      {
        "description": "implies sets another input key",
        "argv": ["tags", "--loud", "--json"],
        "exitCode": 0,
        "stdout": {
          "tags": [],
          "rows": [],
          "loud": true,
          "level": 3
        }
      },
      {
        "description": "a preset option alone takes its preset",
        "argv": ["tags", "--color", "--json"],
        "exitCode": 0,
        "stdout": {
          "tags": [],
          "rows": [],
          "color": "red"
        }
      },
      {
        "description": "a preset option takes a value given after it",
        "argv": ["tags", "--color", "blue", "--json"],
        "exitCode": 0,
        "stdout": {
          "tags": [],
          "rows": [],
          "color": "blue"
        }
      }
    ]
  },
  {
    "description": "a boolean that defaults to true gets a --no- flag",
    "tests": [
      {
        "description": "the --no- flag sets it false",
        "argv": ["admin", "reset", "--no-backup", "--json"],
        "exitCode": 0,
        "stdout": {
          "force": false,
          "backup": false
        }
      },
      {
        "description": "left out, it keeps its default",
        "argv": ["admin", "reset", "--json"],
        "exitCode": 0,
        "stdout": {
          "force": false,
          "backup": true
        }
      },
      {
        "description": "the last flag wins",
        "argv": ["admin", "reset", "--no-backup", "--backup", "--json"],
        "exitCode": 0,
        "stdout": {
          "force": false,
          "backup": true
        }
      }
    ]
  }
]
