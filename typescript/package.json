    "commander": "^14.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "zod": "^4.4.1"
  },
  "peerDependencies": {
    "commander": "^14.0.3",
    "zod": "^4.4.1"
  },
  "engines": {
    "node": "^24.11.0"
  }
}
