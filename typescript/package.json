{
  "name": "fireargs",
  "version": "0.6.2",
  "description": "Build CLIs from zod schemas",
  "keywords": [
    "cli",
    "commander",
    "fireargs",
    "llm",
    "mcp",
    "zod"
  ],
  "license": "MIT",
  "author": "Evgeny Karev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datisthq/fireargs.git",
    "directory": "typescript"
  },
  "files": [
    "build",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": "./build/index.js",
  "scripts": {
    "build": "tsgo --project tsconfig.build.json",
