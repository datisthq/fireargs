{
  "$schema": "https://json.schemastore.org/tsconfig",

  "extends": "./tsconfig.json",
  "exclude": [
    "${configDir}/*.config.ts",
    "${configDir}/**/build/",
    "${configDir}/**/compile/",
    "${configDir}/**/fixtures/",
    "${configDir}/**/examples/",
    "${configDir}/.livemark/",
    "${configDir}/docs/",
    "${configDir}/scripts/",
    "${configDir}/-test/"
  ]
}
