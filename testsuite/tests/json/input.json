[
  {
    "description": "--json <value> drives input",
    "tests": [
      {
        "description": "a JSON value supplies the required positional",
        "argv": ["echo", "--json", "{\"path\":\"b.csv\",\"limit\":3}"],
        "exitCode": 0,
        "stdout": { "path": "b.csv", "limit": 3, "verbose": false }
      },
      {
        "description": "JSON keys are the input keys, not the flag names",
        "argv": ["echo", "--json", "{\"path\":\"b.csv\",\"headerRows\":1}"],
        "exitCode": 0,
        "stdout": { "path": "b.csv", "limit": 20, "verbose": false, "headerRows": 1 }
      },
      {
        "description": "bare --json still reads argv",
        "argv": ["strict", "--count", "12", "--json"],
        "exitCode": 0,
        "stdout": { "count": 12 }
      }
    ]
  }
]
