{
  "name": "fireargs",
  "version": "0.0.0-dev",
  "description": "Build CLIs from zod schemas",
  "keywords": [
    "cli",
    "commander",
    "fireargs",
    "llm",
    "mcp",
    "zod"
  ],
  "license": "MIT",
  "author": "Evgeny Karev",
  "repository": "https://github.com/datisthq/fireargs",
  "files": [
    "build"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": "./build/index.js",
  "scripts": {
    "build": "tsgo",
    "deps": "ncu -u --cooldown 7d",
    "docs:build": "livemark build",
    "docs:start": "livemark start",
    "format": "vp fmt --no-error-on-unmatched-pattern",
    "lint": "vp fmt --check && vp lint",
    "prepare": "lefthook install",
    "release": "pnpm publish --access public --ignore-scripts --no-git-checks",
    "test": "pnpm lint && pnpm type && pnpm unit",
    "type": "tsgo --noEmit",
    "unit": "vp test",
    "leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "scan": "pnpm leaks && pnpm vulns",
    "vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --exclude=\"**/fixtures/**\" --metrics=off"
  },
  "dependencies": {
    "cn": "0.2.4",
    "commander": "^14.0.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@plausible-analytics/tracker": "^0.4.4",
    "@tanstack/react-router": "1.168.1",
    "@tanstack/react-start": "1.167.2",
    "@types/node": "24.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "@vitest/coverage-v8": "4.1.11",
    "lefthook": "2.1.1",
    "livemark": "0.13.0",
    "lucide-react": "0.577.0",
    "npm-check-updates": "23.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tempy": "3.2.0",
    "vite-plus": "0.3.0",
    "wrangler": "4.85.0"
  },
  "engines": {
    "node": "^24.0.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
