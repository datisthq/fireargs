{
  "name": "fireargs",
  "version": "0.4.1",
  "description": "Build CLIs from zod schemas",
  "keywords": [
    "cli",
    "commander",
    "fireargs",
    "llm",
    "mcp",
    "zod"
  ],
  "license": "MIT",
  "author": "Evgeny Karev",
  "repository": "https://github.com/datisthq/fireargs",
  "files": [
    "build"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": "./build/index.js",
  "scripts": {
    "build": "tsgo --project tsconfig.build.json",
    "build:docs": "livemark build",
    "check": "pnpm check:lint && pnpm check:types",
    "check:lint": "vp fmt --check && vp lint",
    "check:types": "tsgo --noEmit",
    "format": "vp fmt --no-error-on-unmatched-pattern",
    "measure:coverage": "vp test --run --coverage",
    "prepare": "lefthook install && node scripts/link-skills.ts",
    "release": "pnpm publish --access public --ignore-scripts --no-git-checks",
    "scan": "pnpm scan:leaks && pnpm scan:vulns",
    "scan:leaks": "gitleaks git --config=.gitleaks.toml --verbose --redact",
    "scan:vulns": "semgrep --config=p/typescript --config=p/nodejs --config=p/owasp-top-ten --config=p/secrets --exclude=\"**/fixtures/**\" --metrics=off",
    "squash": "node scripts/squash-branch.ts",
    "start": "livemark start",
    "test": "pnpm check && pnpm test:unit",
    "test:unit": "vp test",
    "update:deps": "ncu -u --cooldown 7d"
  },
  "dependencies": {
    "cn": "0.2.4",
    "commander": "^14.0.3",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@plausible-analytics/tracker": "^0.4.4",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@types/node": "24.2.0",
    "@typescript/native-preview": "7.0.0-dev.20260316.1",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "2.1.1",
    "livemark": "0.27.1",
    "lucide-react": "0.577.0",
    "npm-check-updates": "23.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tempy": "3.2.0",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "4.85.0"
  },
  "engines": {
    "node": "^24.11.0",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.26.0+sha512.fc0e2bf890b9f983611f1ab68c0637bce914390653699f83c1a78b005ed25f2c81e77920c8fd8eee2ecf0b58b28cdcb00a84d97f69bcf7c56b2f344710238664"
}
